FROM Orders
WHERE TotalAmount > 300;
 
-- Task 3 — Total Order Amount
 
-- Exercise 1 — Calculate total sales
SELECT SUM(TotalAmount) AS TotalSales
FROM Orders;
 
-- Exercise 2 — Calculate sales for orders of $300 or more
SELECT SUM(TotalAmount) AS TotalSales
FROM Orders
WHERE TotalAmount >= 300;
 
