-- task 1
SELECT
    Customer.CustomerName,
    Orders.OrderID
FROM Customer
INNER JOIN Orders
    ON Customer.CustomerID = Orders.CustomerID
GROUP BY
    Customer.CustomerName,
    Orders.OrderID;
    
